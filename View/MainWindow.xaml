<Window x:Class="ToDo_Manager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ToDo_Manager.ViewModels"
        xmlns:models="clr-namespace:ToDo_Manager.Models"
        Title="ToDo Manager"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen" MinHeight="300" MinWidth="700">

    <DockPanel Margin="10">

        <!-- Верхняя панель -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox Width="250" Margin="0,0,10,0"
                     Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Width="120" Margin="0,0,10,0"
                      SelectedItem="{Binding NewTaskPriority}"
                      ItemsSource="{Binding Priorities}" />

            <Button Content="Добавить" Command="{Binding AddTaskCommand}" />
        </StackPanel>

        <!-- Список задач -->
        <ListBox Margin="3" ItemsSource="{Binding Tasks}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- ВАЖНО -->

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TaskItem}">
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <!-- чекбокс -->
                            <ColumnDefinition Width="*"/>
                            <!-- текст + дата -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- приоритет + кнопки -->
                        </Grid.ColumnDefinitions>

                        <!-- Чекбокс -->
                        <CheckBox Grid.Column="0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsCompleted, Mode=TwoWay}" />

                        <!-- Текст задачи + дата -->
                        <StackPanel Grid.Column="1" Margin="8,0">
                            <TextBlock Text="{Binding Title}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top" />

                            <TextBlock Text="{Binding CreatedAt, StringFormat='Создано: {0:dd.MM.yyyy HH:mm}'}"
                       Foreground="Gray"
                       FontSize="11"/>
                        </StackPanel>

                        <!-- Правая панель -->
                        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">

                            <TextBlock Text="{Binding Priority}"
                       Margin="8,0"
                       Foreground="DarkOrange"/>

                            <Button Content="✎"
                    Margin="4"
                    Width="20" Height="20"
                    Click="Edit_Click"/>

                            <Button Content="✖"
                    Margin="4"
                    Width="20" Height="20"
                    Command="{Binding DataContext.DeleteTaskCommand,
                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>


            </ListBox.ItemTemplate>

        </ListBox>

    </DockPanel>
</Window>
