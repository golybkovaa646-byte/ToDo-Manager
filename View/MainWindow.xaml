<Window x:Class="ToDo_Manager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ToDo_Manager.ViewModels"
        Title="ToDo Manager"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen">

    

    <DockPanel Margin="10">

        <!-- Верхняя панель -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox Width="250" Margin="0,0,10,0"
                     Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Width="120" Margin="0,0,10,0"
                      SelectedItem="{Binding NewTaskPriority}"
                      ItemsSource="{Binding Priorities}" />

            <Button Content="Добавить" Command="{Binding AddTaskCommand}" />
        </StackPanel>

        <!-- Список задач -->
        <ListBox ItemsSource="{Binding Tasks}">
            <ListBox.ItemTemplate>
                <DataTemplate>

                    <!-- Адаптивная сетка -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <!-- чекбокс -->
                            <ColumnDefinition Width="*"/>
                            <!-- текст задачи -->
                            <ColumnDefinition Width="120"/>
                            <!-- приоритет -->
                            <ColumnDefinition Width="40"/>
                            <!-- кнопка удаления -->
                        </Grid.ColumnDefinitions>

                        <!-- Чекбокс -->
                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}" />

                        <!-- Текст задачи -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Margin="8,0"
                                   MaxWidth="500"
                                   TextWrapping="Wrap" />

                        <!-- Приоритет -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Priority}"
                                   Margin="8,0"
                                   Foreground="DarkOrange"
                                   VerticalAlignment="Center" />

                        <!-- Кнопка удаления -->
                        <Button Grid.Column="3"
                                Content="✖"
                                MaxHeight="30"
                                MaxWidth="20"
                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
