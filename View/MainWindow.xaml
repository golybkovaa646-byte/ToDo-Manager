<Window x:Class="ToDo_Manager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ToDo_Manager.ViewModels"
        xmlns:models="clr-namespace:ToDo_Manager.Models"
        xmlns:controls="clr-namespace:ToDo_Manager.View.Controls"
        Title="ToDo Manager"
        Height="750"
        Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        MinHeight="400" MinWidth="1050">

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadow"
                          Color="Black"
                          BlurRadius="10"
                          ShadowDepth="2"
                          Opacity="0.2"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <controls:CreateTaskPanelMainWindow Grid.Column="0"/>

        <!-- ПРАВАЯ ПАНЕЛЬ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ФИЛЬТРЫ -->
            <controls:FiltersPanelMainWindow Grid.Row="0"/>

            <!-- СПИСОК ЗАДАЧ -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding FilteredTasks}"
                     Margin="0,15,0,0"
                     HorizontalContentAlignment="Stretch"
                     
                       
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TaskItem}">
                        <controls:TaskCard />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
