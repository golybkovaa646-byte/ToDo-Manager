<Window x:Class="ToDo_Manager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ToDo_Manager.ViewModels"
        xmlns:models="clr-namespace:ToDo_Manager.Models"
        Title="ToDo Manager"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <!-- Верхняя панель -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox Width="250" Margin="0,0,10,0"
                     Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Width="120" Margin="0,0,10,0"
                      SelectedItem="{Binding NewTaskPriority}"
                      ItemsSource="{Binding Priorities}" />

            <Button Content="Добавить" Command="{Binding AddTaskCommand}" />
        </StackPanel>

        <!-- Список задач -->
        <ListBox Margin="3" ItemsSource="{Binding Tasks}"
                 HorizontalContentAlignment="Stretch">
            <!-- ВАЖНО -->

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TaskItem}">

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Margin="8,0"
                                   MaxWidth="450"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding Priority}"
                                   Margin="8,0"
                                   Foreground="DarkOrange"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="✎"
                                    Margin="4"
                                    MaxHeight="20"
                                    MaxWidth="20"
                                    Click="Edit_Click"/>

                            <Button Content="✖"
                                    Margin="4"
                                    MaxHeight="20"
                                    MaxWidth="20"
                                    Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>

                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </DockPanel>
</Window>
