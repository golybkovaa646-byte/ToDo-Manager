<UserControl x:Class="ToDo_Manager.View.Controls.TaskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ToDo_Manager.Models"
             Height="Auto" Width="Auto">

    <UserControl.Resources>

        <!-- Фон карточки -->
        <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FBFBFB" Offset="1"/>
        </LinearGradientBrush>

        
        
        
        
        
        <!-- Тень -->
        <DropShadowEffect x:Key="DropShadow"
                          Color="Black"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Opacity="0.15"/>

        <!-- Hover-анимация карточки -->
        <Style x:Key="CardHoverStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E6E6E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.10"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.015" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.015" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)"
                                                 To="18" Duration="0:0:0.12"/>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                                To="#DADADA" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)"
                                                 To="6" Duration="0:0:0.12"/>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                                To="#E6E6E6" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Зелёный чекбокс -->
        <Style TargetType="CheckBox" x:Key="GreenCheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Box"
                                    Width="22" Height="22"
                                    CornerRadius="4"
                                    Background="#FAFAFA"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="1"/>

                            <Path x:Name="CheckMark"
                                  Data="M 4 11 L 9 16 L 18 6"
                                  Stroke="#4CAF50"
                                  StrokeThickness="2"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Цвет кружочка приоритета -->
        <Style x:Key="PriorityDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="Low">
                    <Setter Property="Fill" Value="#4CAF50"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Priority}" Value="Medium">
                    <Setter Property="Fill" Value="#FF9800"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Priority}" Value="High">
                    <Setter Property="Fill" Value="#E53935"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Цвет текста приоритета -->
        <Style x:Key="PriorityTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="Low">
                    <Setter Property="Foreground" Value="#4CAF50"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Priority}" Value="Medium">
                    <Setter Property="Foreground" Value="#FF9800"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Priority}" Value="High">
                    <Setter Property="Foreground" Value="#E53935"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    
    
    
    
    <!-- Карточка -->
    <Border x:Name="Root" 
            Margin="10"
            ClipToBounds="True">

        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource CardHoverStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                        <Setter Property="Background" Value="#E6F7E6"/>
                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Чекбокс -->
            <CheckBox Style="{StaticResource GreenCheckBox}"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                      Cursor="Hand"/>

            <!-- Основной текст -->
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="#222"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding Description}"
                           FontSize="13"
                           Foreground="#666"
                           MaxWidth="450"
                           TextWrapping="Wrap"
                           TextTrimming="WordEllipsis"
                           Margin="0,6,0,0"/>

                <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:dd.MM.yyyy HH:mm}'}"
                           Foreground="#9A9A9A"
                           FontSize="11"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Правая панель -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,4,0">

                <!-- Цветной кружок -->
                <Ellipse Style="{StaticResource PriorityDotStyle}"/>

                <!-- Текст приоритета -->
                <TextBlock Text="{Binding Priority}"
                           Style="{StaticResource PriorityTextStyle}"
                           VerticalAlignment="Center"/>

                <!-- Edit -->
                <Button Width="34" Height="34"
                        Margin="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Edit"
                        Command="{Binding DataContext.OpenEditWindowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}">
                    <Viewbox Width="14" Height="14">
                        <Path Data="M3,17 L17,3 L21,7 L7,21 L3,21 z" Fill="#555"/>
                    </Viewbox>
                </Button>

                <!-- Delete -->
                <Button Width="34" Height="34"
                        Margin="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Delete"
                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}">
                    <Viewbox Width="14" Height="14">
                        <Path Data="M3,6 L21,6 L19,22 L5,22 z M8,6 L8,4 L16,4 L16,6" Fill="#C62828"/>
                    </Viewbox>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>