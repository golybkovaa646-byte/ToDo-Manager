<UserControl x:Class="ToDo_Manager.View.Controls.FiltersPanelMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDo_Manager.View.Controls"
        mc:Ignorable="d"
        Height="Auto" Width="Auto">
    <Border Background="White"
            CornerRadius="10"
            Padding="15"
            BorderBrush="#DDD"
            BorderThickness="1"
            
            Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Filters:"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>

                <ComboBox Width="150"
                          ItemsSource="{Binding Priorities}"
                          SelectedItem="{Binding SelectedFilterPriority}"
                          Margin="0,0,10,0"/>

                <CheckBox Content="Show completed"
                          IsChecked="{Binding ShowCompleted}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Clear Filters"
                    Command="{Binding ClearFiltersCommand}"
                    Background="Orange"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Padding="10,5"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="100"/>
        </Grid>
    </Border>
</UserControl>
