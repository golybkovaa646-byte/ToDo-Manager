<UserControl x:Class="ToDo_Manager.View.Controls.CreateTaskPanelMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDo_Manager.View.Controls"
        mc:Ignorable="d"
         Height="Auto" Width="Auto">
    
    



    <Border Background="White"
            CornerRadius="10"
            Padding="20"
            Margin="0,0,15,0"
            BorderBrush="#DDD"
            BorderThickness="1"
            >
        <StackPanel>
            <TextBlock Text="Create Task"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Title" FontWeight="Bold"/>
            <TextBlock Text="Maximum 25 characters"
                       Foreground="Gray"
                       FontSize="10"/>
            <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="25"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Description" FontWeight="Bold"/>
            <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Priority" FontWeight="Bold"/>
            <ComboBox ItemsSource="{Binding Priorities}"
                      SelectedItem="{Binding NewTaskPriority}"
                      Margin="0,0,0,15"/>

            <Button Content="Add Task"
                    Command="{Binding AddTaskCommand}"
                    Height="40"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Border>
</UserControl>
