<UserControl x:Class="ToDo_Manager.View.Controls.CreateTaskPanelTaskPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="Auto" Width="Auto">

    <UserControl.Resources>

        <!-- Градиентный фон карточки -->
        <LinearGradientBrush x:Key="PanelBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="1"/>
            <GradientStop Color="#F9F6F3" Offset="0.3"/>
        </LinearGradientBrush>

        <!-- Тень -->
        <DropShadowEffect x:Key="PanelShadow"
                          Color="#000000"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.15"/>

        <!-- Стиль TextBox -->
        <Style TargetType="TextBox" x:Key="InputBoxStyle">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox" x:Key="ComboStyle">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Основной фон -->
                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="8">
                                <DockPanel>
                                    <!-- Текст выбранного элемента -->
                                    <ContentPresenter Margin="4,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                                    <!-- Кнопка стрелки -->
                                    <ToggleButton x:Name="ToggleButton"
                                          DockPanel.Dock="Right"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Width="24"
                                          Height="24"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                        <Path Data="M 0 0 L 10 0 L 5 5 Z"
                                      Fill="#555"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </DockPanel>
                            </Border>

                            <!-- Выпадающий список -->
                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Border Background="White"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="5"
                                SnapsToDevicePixels="True"
                                Effect="{StaticResource PanelShadow}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#A5D6A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Стиль кнопки -->
        <Style TargetType="Button" x:Key="AddButtonStyle">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#43A047"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Border Background="{StaticResource PanelBackground}"
        CornerRadius="14"
        Padding="30"
        Margin="0,0,15,0"
        BorderBrush="#E5E5E5"
        BorderThickness="1"
        Effect="{StaticResource PanelShadow}">

        <StackPanel>

            <!-- Заголовок -->
            <StackPanel Margin="0,0,0,25">
                <TextBlock Text="Create Task"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>

                <TextBlock Text="Add a new task to your list"
                       FontSize="14"
                       Foreground="#777"/>
            </StackPanel>

            <!-- Title -->
            <TextBlock Text="Title" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="Maximum 45 characters"
                   Foreground="#888"
                   FontSize="13"
                   Margin="0,0,0,5"/>

            <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="45"
                 Style="{StaticResource InputBoxStyle}"
                 Margin="0,0,0,20"/>

            <!-- Description -->
            <TextBlock Text="Description" FontWeight="Bold" FontSize="16"/>
            <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                 Height="100"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Style="{StaticResource InputBoxStyle}"
                 Margin="0,0,0,20"/>

            <!-- Priority -->
            <TextBlock Text="Priority" FontWeight="Bold" FontSize="16" />
            <ComboBox ItemsSource="{Binding Priorities}"
                  SelectedItem="{Binding NewTaskPriority}"
                  Style="{StaticResource ComboStyle}"
                  Margin="0,0,0,25"/>


               <!--авав-->
            <TextBlock Text="Tag" FontWeight="Bold" FontSize="16" />
            <ComboBox ItemsSource="{Binding AvailableTags}"
          SelectedItem="{Binding NewTaskTag}"
          Style="{StaticResource ComboStyle}"
          Margin="0,0,0,25">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>


            <!-- Button -->
            <Button Content="Add Task"
                Command="{Binding AddTaskCommand}"
                Style="{StaticResource AddButtonStyle}"
                Height="48"
                Margin="0,10,0,0"/>
        </StackPanel>
    </Border>

</UserControl>
