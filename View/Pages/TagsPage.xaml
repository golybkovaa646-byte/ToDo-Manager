<Page x:Class="ToDo_Manager.View.Pages.TagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controlsTags="clr-namespace:ToDo_Manager.View.Controls.TagsPageElements"
      xmlns:controlsCommon="clr-namespace:ToDo_Manager.View.Controls.Common"
      mc:Ignorable="d">

    <Page.Resources>

        <Storyboard x:Key="LeftPanelAppearAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1" Duration="0:0:1.45"/>

            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                     From="20" To="0" Duration="0:0:1.45"/>
        </Storyboard>


        <!-- Мягкий фон как в TasksPage -->
        <LinearGradientBrush x:Key="MainBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F9F6F3" Offset="1"/>
        </LinearGradientBrush>

        <!-- Тень карточки -->
        <DropShadowEffect x:Key="PanelShadow"
                          Color="#000000"
                          BlurRadius="26"
                          ShadowDepth="2"
                          Opacity="0.25"/>

        <!-- Стиль TextBox как в CreateTaskPanel -->
        <Style TargetType="TextBox" x:Key="InputBoxStyle">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль кнопки -->
        <Style TargetType="Button" x:Key="AddButtonStyle">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#43A047"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource MainBackground}" Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: Добавление тега -->
        <controlsTags:CreateTagPanelTagsPage Grid.Column="0"
                                     Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
            <controlsTags:CreateTagPanelTagsPage.RenderTransform>
                <TranslateTransform Y="20"/>
            </controlsTags:CreateTagPanelTagsPage.RenderTransform>

            <controlsTags:CreateTagPanelTagsPage.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource LeftPanelAppearAnimation}"/>
                </EventTrigger>
            </controlsTags:CreateTagPanelTagsPage.Triggers>
        </controlsTags:CreateTagPanelTagsPage>



        <!-- ПРАВАЯ ПАНЕЛЬ: список тегов -->
        <Grid Grid.Column="1">
            <Border CornerRadius="14"
                    Background="White"
                    Padding="12"
                    SnapsToDevicePixels="True"
                    Effect="{StaticResource PanelShadow}">

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controlsCommon:TagCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Border>
        </Grid>

    </Grid>
</Page>
